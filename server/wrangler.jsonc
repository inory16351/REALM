{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crown-discard-online",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-14",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_ROOM",
				"class_name": "GameRoom"
			}
		]
	},
	"exports": {
		"GameRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"observability": { "enabled": true },
	"upload_source_maps": true
}
